# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Database
# Leave unset to use a local SQLite development fallback.
# Use PostgreSQL in shared/staging/production environments.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/dynamic_eta
ENVIRONMENT=development

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Data providers. DEMO is the safe local-development fallback.
DATA_PROVIDER=demo
RAILWAY_API_BASE_URL=
RAILWAY_API_KEY=
# Optional override; the documented default is https://api.railradar.in.
RAILRADAR_API_BASE_URL=https://api.railradar.in
WEATHER_API_BASE_URL=
OPENWEATHER_API_KEY=
STALE_AFTER_SECONDS=30
REALTIME_INTERVAL_SECONDS=2
